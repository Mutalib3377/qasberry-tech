// prisma/schema.prisma
// Qasberry platform — full schema for all 11 models
// Run: npx prisma migrate dev --name init
// Env var: DATABASE_URL (PostgreSQL connection string)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  CONTENT_MANAGER
  MODERATOR
  STUDENT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  VIDEO
  READING
  QUIZ
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  clerkId     String   @unique
  email       String   @unique
  name        String?
  role        UserRole @default(STUDENT)
  career      String?
  isSuspended Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  enrollments      Enrollment[]
  progress         Progress[]
  certificates     Certificate[]
  posts            Post[]
  communityMembers CommunityMember[]
  quizAttempts     QuizAttempt[]

  @@map("users")
}

model Career {
  id   String @id @default(cuid())
  name String
  slug String @unique

  // Relations
  courses     Course[]
  communities Community[]

  @@map("careers")
}

model Course {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  description String?
  thumbnail   String?
  price       Decimal          @default(0) @db.Decimal(10, 2)
  isFree      Boolean          @default(false)
  status      CourseStatus     @default(DRAFT)
  difficulty  CourseDifficulty @default(BEGINNER)
  careerId    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  career       Career        @relation(fields: [careerId], references: [id])
  modules      Module[]
  enrollments  Enrollment[]
  certificates Certificate[]

  @@map("courses")
}

model Module {
  id       String @id @default(cuid())
  courseId String
  title    String
  order    Int

  // Relations
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@map("modules")
}

model Lesson {
  id                String     @id @default(cuid())
  moduleId          String
  title             String
  videoUrl          String? // YouTube / Google Drive / external video link — legacy fallback, kept permanently
  pdfUrl            String? // Google Drive / external PDF link — legacy fallback, kept permanently
  muxAssetId        String?
  muxPlaybackId     String?
  muxError          String? // set by the video.asset.errored webhook handler (P7) — lets the admin UI show a real error instead of polling forever
  duration          Int? // in seconds
  order             Int
  isFree            Boolean    @default(false) // free preview lesson
  type              LessonType @default(VIDEO)
  isRequired        Boolean    @default(true) // must be completed for course completion
  // Only one lesson per course may have isFinalAssessment = true — enforced by a Postgres
  // trigger (enforce_single_final_assessment) added by hand in the p1_quiz_lesson_types
  // migration.sql, not expressible as a Prisma @@unique since it spans Lesson -> Module -> Course.
  // `prisma db pull` will not surface this trigger — see that migration file for the definition.
  isFinalAssessment Boolean    @default(false)
  documentKey       String? // Supabase Storage object path for an uploaded PDF (replaces pdfUrl going forward)
  content           String? // optional markdown/rich text body for reading lessons
  quizId            String?    @unique
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Relations
  module   Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress Progress[]
  quiz     Quiz?      @relation(fields: [quizId], references: [id])

  @@map("lessons")
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  paymentRef String?
  createdAt  DateTime @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // A user can only be enrolled in a course once
  @@unique([userId, courseId])
  @@map("enrollments")
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // A user can only complete a lesson once
  @@unique([userId, lessonId])
  @@map("progress")
}

model Certificate {
  id             String   @id @default(cuid())
  userId         String
  courseId       String
  issuedAt       DateTime @default(now())
  certificateUrl String?
  finalScore     Int? // % score on the final-assessment quiz attempt that unlocked this certificate, if any

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

// ─── Quiz / Assessment models ──────────────────────────────────────────────

model Quiz {
  id           String   @id @default(cuid())
  title        String
  instructions String?
  passingScore Int // percentage, e.g. 70
  maxAttempts  Int? // null = unlimited retakes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  lesson    Lesson?
  questions Question[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id     String @id @default(cuid())
  quizId String
  prompt String
  order  Int
  points Int    @default(1)

  // Relations
  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options Option[]
  answers QuizAnswer[]

  @@index([quizId])
  @@map("questions")
}

model Option {
  id         String  @id @default(cuid())
  questionId String
  text       String
  order      Int
  isCorrect  Boolean @default(false)
  // Security: NEVER select this field into a student-facing API response (enforced in P4/P8, not here).

  // Relations
  question Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAnswer[]

  @@index([questionId])
  @@map("options")
}

model QuizAttempt {
  id          String    @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  passed      Boolean
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  // Relations
  user    User         @relation(fields: [userId], references: [id])
  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([userId, quizId])
  @@index([quizId, passed, score]) // supports "best attempt" read-time query
  @@map("quiz_attempts")
}

model QuizAnswer {
  id               String @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String

  // Relations
  attempt        QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id])
  selectedOption Option      @relation(fields: [selectedOptionId], references: [id])

  @@index([attemptId])
  @@map("quiz_answers")
}

model Community {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  careerId    String
  description String?

  // Relations
  career  Career            @relation(fields: [careerId], references: [id])
  posts   Post[]
  members CommunityMember[]

  @@map("communities")
}

model Post {
  id          String   @id @default(cuid())
  communityId String
  userId      String
  content     String
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("posts")
}

model CommunityMember {
  id          String   @id @default(cuid())
  userId      String
  communityId String
  joinedAt    DateTime @default(now())

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  // A user can only be a member of a community once
  @@unique([userId, communityId])
  @@map("community_members")
}
